# AK Fitness - E-posta Yapılandırması
# Bu dosyayı .env olarak kopyalayın ve kendi SMTP ayarlarınızı ekleyin

# SMTP Sunucu Ayarları
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# E-posta Hesap Bilgileri
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Gönderici ve Alıcı E-posta Adresleri
FROM_EMAIL=your-email@gmail.com
FROM_NAME=AK Fitness
TO_EMAIL=info@akfitness.com

# Gmail App Password Oluşturma:
# 1. Google Hesabınıza gidin
# 2. Güvenlik > 2 Adımlı Doğrulama'yı açın
# 3. Uygulama Şifreleri > Yeni uygulama şifresi oluşturun
# 4. Oluşturulan 16 haneli şifreyi SMTP_PASS olarak kullanın

# Alternatif SMTP Sağlayıcıları:
# 
# Outlook/Hotmail:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# 
# Yahoo:
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=587
# 
# Yandex:
# SMTP_HOST=smtp.yandex.com
# SMTP_PORT=587
# 
# ProtonMail:
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025

# Form Ayarları
FORM_SUBJECT=AK Fitness - Yeni Üyelik Başvurusu
SUCCESS_MESSAGE=Mesajınız başarıyla gönderildi! En kısa sürede size dönüş yapacağız.
ERROR_MESSAGE=Mesaj gönderilirken bir hata oluştu. Lütfen tekrar deneyin.

# Güvenlik Ayarları
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Rate Limiting (İsteğe bağlı)
MAX_REQUESTS_PER_HOUR=10
BLOCK_DURATION_MINUTES=60 